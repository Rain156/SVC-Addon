{
  "schemaVersion": 1,
  "id": "svc_addon",
  "version": "${version}",
  "name": "SVC Addon",
  "description": "Continuous loudness-based proximity range and acoustic path tracing for Simple Voice Chat.",
  "authors": ["datura"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["datura.svcaddon.fabric.SvcAddonFabric"],
    "voicechat": ["datura.svcaddon.voice.SvcAddonVoicechatPlugin"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "voicechat": ">=2.6.20",
    "voicechat_api": ">=${voicechat_api_version}"
  }
}
